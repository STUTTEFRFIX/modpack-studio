{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/modrinth.index.schema.json",
  "title": "modrinth.index.json",
  "description": "Modrinth .mrpack 清单。依据 Modrinth 官方格式说明。",
  "type": "object",
  "required": [
    "formatVersion",
    "game",
    "versionId",
    "name",
    "files",
    "dependencies"
  ],
  "properties": {
    "formatVersion": {
      "const": 1,
      "description": "当前规范版本为 1"
    },
    "game": {
      "const": "minecraft"
    },
    "versionId": {
      "type": "string",
      "minLength": 1,
      "description": "该整合包版本的唯一 ID"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hashes", "downloads", "fileSize"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              { "not": { "pattern": "^[/\\\\]" } },
              { "not": { "pattern": "^[A-Za-z]:" } },
              { "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
              { "not": { "pattern": "\\\\" } }
            ],
            "description": "相对实例根目录的路径，如 mods/foo.jar；禁止绝对路径、盘符、反斜杠和 .. 路径段"
          },
          "hashes": {
            "type": "object",
            "required": ["sha1", "sha512"],
            "properties": {
              "sha1": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{40}$"
              },
              "sha512": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{128}$"
              }
            },
            "additionalProperties": true
          },
          "env": {
            "type": "object",
            "properties": {
              "client": {
                "enum": ["required", "optional", "unsupported"]
              },
              "server": {
                "enum": ["required", "optional", "unsupported"]
              }
            },
            "additionalProperties": false
          },
          "downloads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "description": "HTTPS 下载地址，按顺序尝试"
          },
          "fileSize": {
            "type": "integer",
            "minimum": 0,
            "description": "字节数，仅用于进度显示，不用于严格校验"
          }
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "object",
      "minProperties": 1,
      "required": ["minecraft"],
      "properties": {
        "minecraft": {
          "type": "string",
          "minLength": 1
        },
        "forge": {
          "type": "string"
        },
        "neoforge": {
          "type": "string"
        },
        "fabric-loader": {
          "type": "string"
        },
        "quilt-loader": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "已知键为 minecraft/forge/neoforge/fabric-loader/quilt-loader；未知键应忽略而不是报错"
    }
  },
  "additionalProperties": true
}
