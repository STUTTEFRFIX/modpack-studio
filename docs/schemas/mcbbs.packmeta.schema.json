{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/mcbbs.packmeta.schema.json",
  "title": "mcbbs.packmeta / MCBBS manifest.json",
  "description": "MCBBS 整合包清单 v1/v2。依据 HMCL/FCL/PCL2 的解析实现归纳。v1 使用 manifest.json，v2 使用 mcbbs.packmeta 并附带 CurseForge 兼容 manifest.json。",
  "type": "object",
  "required": [
    "manifestType",
    "manifestVersion",
    "name",
    "version",
    "author",
    "addons",
    "files"
  ],
  "properties": {
    "manifestType": {
      "const": "minecraftModpack"
    },
    "manifestVersion": {
      "type": "integer",
      "enum": [1, 2],
      "description": "v1 为 1，v2 为 2"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "v2 要求满足 Maven/SemVer 规范"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fileApi": {
      "type": ["string", "null"],
      "description": "附加文件下载根地址；为 null 表示文件全部内置"
    },
    "url": {
      "type": "string"
    },
    "forceUpdate": {
      "type": "boolean"
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "addons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string",
            "description": "game/forge/neoforge/fabric/quilt/liteloader/optifine/cleanroom/legacyfabric 等"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Maven 坐标，如 com.example:example:1.0.0"
          },
          "url": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "path", "hash"],
            "properties": {
              "type": {
                "const": "addon"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "相对 overrides/ 的路径"
              },
              "hash": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{40}$",
                "description": "SHA-1"
              },
              "force": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": ["type", "projectID", "fileID"],
            "properties": {
              "type": {
                "const": "curse"
              },
              "projectID": {
                "type": "integer",
                "minimum": 1
              },
              "fileID": {
                "type": "integer",
                "minimum": 1
              },
              "fileName": {
                "type": ["string", "null"]
              },
              "url": {
                "type": "string"
              },
              "force": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "install_mods": {
          "type": "boolean",
          "default": true
        },
        "install_resourcepack": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": true
    },
    "launchInfo": {
      "type": "object",
      "properties": {
        "minMemory": {
          "type": "integer",
          "minimum": 0
        },
        "supportJava": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "launchArgument": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "javaArgument": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
