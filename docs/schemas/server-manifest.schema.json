{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/server-manifest.schema.json",
  "title": "HMCL server-manifest.json",
  "description": "HMCL/FCL 服务端整合包清单。ZIP 内另有 overrides/ 目录。",
  "type": "object",
  "required": ["fileApi", "files", "addons"],
  "properties": {
    "name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fileApi": {
      "type": ["string", "null"],
      "description": "文件根地址；与 /overrides/<path> 拼接"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "相对实例根目录（也相对 overrides/）的路径"
          },
          "hash": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{40}$",
            "description": "SHA-1"
          },
          "downloadURL": {
            "type": ["string", "null"],
            "description": "显式下载地址（保留字段）；HMCL 当前实现仍按 fileApi + /overrides/ + path 下载"
          }
        },
        "additionalProperties": true
      }
    },
    "addons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
